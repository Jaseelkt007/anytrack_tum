# Phase 1 environment variables. Copy to .env and fill in.
# .env is git-ignored — never commit real credentials.

# --- Neo4j AuraDB Free ---
# Provision at https://console.neo4j.io and use the connection string from the dashboard.
# URI looks like: neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- GitHub PAT ---
# Each team member creates their own at https://github.com/settings/tokens
# Required scope: public_repo (or no scopes for fully public read access — that's fine for Phase 1).
# Note your username so we can identify which token belongs to whom in logs.
GITHUB_TOKEN=
GITHUB_USERNAME=

# --- Anthropic (optional in Phase 1, used in Phase 2 for "why now" NLG) ---
ANTHROPIC_API_KEY=

# --- Backend / frontend (used in M6, M7) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
