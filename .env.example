# AnyTrace v2 environment variables. Copy to .env and fill in.
# .env is git-ignored — never commit real credentials.

# --- Postgres (Neon recommended; local Docker fallback below) ---
# Neon: provision at https://console.neon.tech and copy connection strings.
# Pooled URL is used by the app (asyncpg); direct URL by Alembic (psycopg).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# Local Docker fallback (alternative to Neon for offline dev):
# DATABASE_URL=postgresql+asyncpg://anytrace:anytrace@127.0.0.1:5433/anytrace
# DATABASE_URL_DIRECT=postgresql+psycopg://anytrace:anytrace@127.0.0.1:5433/anytrace

# --- Browser pool (sub-project #4; only needed by LinkedIn etc.) ---
# Local docker: docker compose --profile browser up postgres browserless
# BROWSERLESS_WS_URL=ws://127.0.0.1:3000
# BROWSERLESS_TOKEN=

# --- GitHub PAT ---
# Each team member creates their own at https://github.com/settings/tokens
# Required scope: public_repo (or no scopes for fully public read access — that's fine for Phase 1).
# Note your username so we can identify which token belongs to whom in logs.
GITHUB_TOKEN=
GITHUB_USERNAME=

# --- Gemini (Phase 2 / M7 — used by the identity resolver's LLM arbitration tier) ---
# Provision at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Scrapebadger (Phase 2 / M8 — Twitter follow ingest) ---
# Sign up at https://scrapebadger.com
SCRAPEBADGER_API_KEY=

# --- Backend / frontend (used in M6) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# --- Pipeline scheduler (M12) ---
# Interval between full pipeline runs (Twitter ingest -> convergence -> dossier sweep).
PIPELINE_INTERVAL_HOURS=6
# Set to 1/true/yes to skip the slow Twitter ingest stage (useful during dev).
PIPELINE_SKIP_TWITTER=
# Set to 1/true/yes to fire one pipeline run when the backend starts.
PIPELINE_RUN_ON_STARTUP=
# Set to 1/true/yes to disable the scheduler entirely (cron / external orchestration).
PIPELINE_SCHEDULER_DISABLED=
# Only dossier-ize ConvergenceEvents whose score is at least this. 0 = all.
DOSSIER_SCORE_THRESHOLD=0.0

# --- Email digest (M12-email — Resend) ---
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Sender domain. For testing, use 'onboarding@resend.dev' (Resend's verified
# sender). For production, verify your own domain at https://resend.com/domains.
NOTIFY_FROM_EMAIL=onboarding@resend.dev
NOTIFY_FROM_NAME=Signal Convergence
# Hours between automatic digest sends (the scheduler tick interval). Default 24.
PIPELINE_DIGEST_INTERVAL_HOURS=24
# Set to 1/true/yes to disable the digest scheduler entirely.
PIPELINE_DIGEST_DISABLED=
